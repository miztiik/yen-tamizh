# Node / frontend build
node_modules/
dist/
dev-dist/
*.tsbuildinfo
.vite/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Python / backend
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
build/

# Editor / OS
.DS_Store
Thumbs.db

# Raw corpus inputs (Row 8). Hundreds of MB of third-party word lists that the
# ingest streams; only the derived, ranked master wordlist is committed. See
# datasets/corpus/README.md for how to repopulate them.
datasets/corpus/*
!datasets/corpus/README.md

# Raw lexicon inputs (wordsmith row 4). Same rule, same reason: hundreds of MB of
# third-party dictionaries and word lists that the pipeline streams. Only the
# committed fixture slices under datasets/fixtures/lexicon/ and the published
# artifacts ship. See datasets/lexicon/sources/README.md to repopulate them.
datasets/lexicon/sources/*
!datasets/lexicon/sources/README.md

# The one source that is AUTHORED rather than acquired (wordsmith row 10). The
# rule above exists to keep unreviewed third-party bytes out of history; these
# bytes are ours, reviewable line by line, and are the record of what the game
# tells a player a word means, so they are committed. Only that one file - a
# stray download dropped in the same directory stays ignored.
!datasets/lexicon/sources/llm-authored/
datasets/lexicon/sources/llm-authored/*
!datasets/lexicon/sources/llm-authored/entries.jsonl

# Build cache of the wordsmith stages (extracts, the staging SQLite store).
datasets/lexicon/cache/

# The REVIEW reports (wordsmith row 9b). Working material a person reads between
# runs - the unclassified residue, the refusals, the enrichment queue - running
# to hundreds of MB and regenerated by the pipeline, so the bytes never ship.
# Only the README saying what each file is stays committed.
datasets/lexicon/review/*
!datasets/lexicon/review/README.md

# Scratch
.tmp_*
