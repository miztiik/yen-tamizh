{
  "version": "2026-08-14",
  "changelog": [
    {
      "version": "2026-08-14",
      "change": "Initial lexicon source registry: per-source role, precedence, sha256 and reader mapping across the delimited / json-array / jsonl kinds, plus the POS and category alias maps.",
      "why": "Row 3 - contracts before logic (Holy Law #3). elementKind lands in the initial mint rather than with the readers: two acquired sources hold bare string array elements, and reopening a contract three rows after it shipped is a Holy Law #3 inversion."
    }
  ],
  "lexiconRoot": "datasets/lexicon",
  "outputs": ["ndjson"],
  "posAliases": {
    "Adjectives": { "pos": ["adjective"] },
    "Nouns": {
      "pos": ["noun"],
      "note": "The curated themed source files parts of speech as categories on 827 of its 1,290 rows. It is a real classification over a hand-checked set, unlike the blanket 'nouns' stamp below."
    },
    "Verbs": { "pos": ["verb"] },
    "a": { "pos": ["adjective"] },
    "a.adv": { "pos": ["adjective", "adverb"] },
    "adj": { "pos": ["adjective"] },
    "adv": { "pos": ["adverb"] },
    "art": {
      "reject": "noTamilCounterpart",
      "note": "Describes the English headword. Tamil has no article in any form, so the Tamil side's part of speech is simply unknown."
    },
    "character": { "reject": "notAWord" },
    "conj": { "pos": ["conjunction"] },
    "contraction": { "wordClassEvidence": ["colloquial"] },
    "det": { "pos": ["determiner"] },
    "int": { "pos": ["interjection"] },
    "interfix": { "wordClassEvidence": ["boundStem"] },
    "intj": { "pos": ["interjection"] },
    "n": { "pos": ["noun"] },
    "n.pl": {
      "pos": ["noun"],
      "wordClassEvidence": ["inflected"],
      "note": "Two facts in one tag: it is a noun, and the form carried is a plural rather than the lemma. Each goes to its own home."
    },
    "name": { "wordClassEvidence": ["properNoun"] },
    "noun": { "pos": ["noun"] },
    "nouns": {
      "reject": "notAPosLabel",
      "note": "The curated master dictionary stamps this on 104,221 of its 104,421 rows (99.8 percent), verbs included, so as the source uses it the value classifies nothing. Counted over the whole file on 2026-08-15; its four real tags - trees, flowers, birds, animals - route to categoryAliases."
    },
    "num": { "pos": ["numeral"] },
    "particle": { "pos": ["particle"] },
    "phrase": { "reject": "multiWordUnit" },
    "postp": { "pos": ["postposition"] },
    "prefix": { "wordClassEvidence": ["boundStem"] },
    "prep": {
      "pos": ["postposition"],
      "note": "The label describes the ENGLISH headword; the Tamil side of all 34 rows is Tamil's own adposition, which is postpositional."
    },
    "pron": { "pos": ["pronoun"] },
    "proverb": { "reject": "multiWordUnit" },
    "rel": {
      "reject": "noTamilCounterpart",
      "note": "One row, the relative sense of English 'but'. Tamil expresses it with a verbal form rather than a word class."
    },
    "suffix": { "wordClassEvidence": ["boundStem"] },
    "symbol": { "reject": "notAWord" },
    "v": { "pos": ["verb"] },
    "verb": { "pos": ["verb"] }
  },
