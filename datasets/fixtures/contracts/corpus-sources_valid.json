{
  "version": "2026-08-13",
  "changelog": [
    {
      "version": "2026-08-13",
      "change": "Demonstrator corpus source registry: one delimited source and one json-array source.",
      "why": "Row 8 - the shared fixture proving a registry is accepted and a mis-mapped one is rejected."
    }
  ],
  "corpusRoot": "datasets/corpus",
  "filters": {
    "minLength": 2,
    "maxLength": 12,
    "minTotalFrequency": 5,
    "maxWords": 50000,
    "dropCategories": ["nouns"]
  },
  "bands": {
    "commonMaxPercentile": 0.1,
    "midMaxPercentile": 0.5
  },
  "sources": [
    {
      "id": "demo-frequency",
      "name": "Demonstrator word,count frequency list",
      "origin": "datasets/fixtures/contracts/corpus-sources_valid.json",
      "kind": "delimited",
      "path": "demo-frequency/source.csv",
      "delimiter": ",",
      "hasHeader": true,
      "wordColumn": 0,
      "countColumn": 1
    },
    {
      "id": "demo-dictionary",
      "name": "Demonstrator JSON dictionary",
      "origin": "datasets/fixtures/contracts/corpus-sources_valid.json",
      "kind": "json-array",
      "path": "demo-dictionary/source.json",
      "rootKey": "data",
      "wordField": "ta",
      "countField": "word_frequency",
      "categoryField": "category",
      "enabled": false,
      "note": "Disabled on purpose - a disabled source is skipped without its bytes being read."
    }
  ]
}
